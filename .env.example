# Copy to ".env" and fill in. Vite only exposes vars prefixed with VITE_.

# Where the maze should POST consented gameplay runs. Leave unset to keep
# gameplay data in the browser only (no network). Point at your collector:
#   local dev:   http://localhost:8787/collect
#   production:  https://collector.yourdomain.com/collect
VITE_MAZE_COLLECTOR=

# ---- collector server settings (used by `npm run collector`) ----
# PORT=8787
# DATA_FILE=collector/data/maze-runs.jsonl
# CORS_ORIGIN=*                      # set to your site origin in production
# COLLECTOR_TOKEN=                   # required to read /runs and /stats
# MAX_BODY_BYTES=65536
# MAX_FILE_BYTES=524288000           # stop accepting once the dataset hits this size
# RATE_MAX=240                       # requests per IP per minute
